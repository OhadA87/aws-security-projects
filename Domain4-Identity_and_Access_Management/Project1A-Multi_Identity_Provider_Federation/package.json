{
  "name": "multi-identity-provider-federation",
  "version": "1.0.0",
  "description": "Enterprise Multi-Identity Provider Federation using AWS IAM Identity Center",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "cdk": "cdk",
    "lint": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "synth": "cdk synth",
    "deploy:dev": "cdk deploy --all --context environment=dev",
    "deploy:staging": "cdk deploy --all --context environment=staging",
    "deploy:prod": "cdk deploy --all --context environment=prod",
    "destroy:dev": "cdk destroy --all --context environment=dev",
    "security:scan": "cdk-nag --app='npx ts-node bin/app.ts'"
  },
  "keywords": [
    "aws",
    "cdk",
    "iam",
    "identity-center",
    "federation",
    "security",
    "enterprise"
  ],
  "author": "AWS Security Team",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "^20.6.3",
    "@typescript-eslint/eslint-plugin": "^6.7.2",
    "@typescript-eslint/parser": "^6.7.2",
    "eslint": "^8.49.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.100.0",
    "cdk-nag": "^2.27.0",
    "constructs": "^10.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}